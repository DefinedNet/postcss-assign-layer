{
  "name": "postcss-assign-layer",
  "version": "0.4.0",
  "description": "PostCSS plugin to assign a cascade layer to files.",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "postcss-assign-layer"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --cjsInterop --splitting",
    "test": "vitest run --coverage && eslint .",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "author": "Ian VanSchooten <ian.vanschooten@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DefinedNet/postcss-assign-layer.git"
  },
  "homepage": "https://github.com/DefinedNet/postcss-assign-layer#readme",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.3.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^8.56.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "clean-publish": "^7.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.5.1"
  },
  "packageManager": "pnpm@10.34.9"
}
